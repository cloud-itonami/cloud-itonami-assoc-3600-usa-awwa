(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [association :string] :bool
  (string=? association "awwa"))
(defn entry-count [association :string] :i64
  (if (association-covered? association) 2 0))
(defn valid-entry? [association :string index :i64] :bool
  (if (association-covered? association)
    (if (= index 0) true (if (= index 1) true false))
    false))

(defn entry-field [association :string index :i64 field :string]
  [:option :string]
  (if (valid-entry? association index)
    (if (= index 0)
      (cond
        (string=? field "id") (option-some-of [:option :string] "awwa.policy-distribution-system-water-quality")
        (string=? field "title") (option-some-of [:option :string] "AWWA Policy Statement on Distribution System Water Quality")
        (string=? field "association") (option-some-of [:option :string] "awwa")
        (string=? field "isic") (option-some-of [:option :string] "3600")
        (string=? field "country") (option-some-of [:option :string] "USA")
        (string=? field "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? field "url") (option-some-of [:option :string] "https://www.awwa.org/policy-statement/distribution-system-water-quality/")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "established-date") (option-some-of [:option :string] "1975-01-26")
        (string=? field "last-revised-date") (option-some-of [:option :string] "2026-04-01")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string]))
      (cond
        (string=? field "id") (option-some-of [:option :string] "awwa.who-we-are-profile")
        (string=? field "title") (option-some-of [:option :string] "Who We Are (organization profile)")
        (string=? field "association") (option-some-of [:option :string] "awwa")
        (string=? field "isic") (option-some-of [:option :string] "3600")
        (string=? field "country") (option-some-of [:option :string] "USA")
        (string=? field "kind") (option-some-of [:option :string] "governance-program")
        (string=? field "url") (option-some-of [:option :string] "https://www.awwa.org/who-we-are/")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "established-date") (option-some-of [:option :string] "1881-03-29")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn topic-count [association :string index :i64] :i64
  (if (valid-entry? association index) (if (= index 0) 2 1) 0))
(defn topic [association :string index :i64 topic-index :i64]
  [:option :string]
  (if (valid-entry? association index)
    (if (= index 0)
      (if (= topic-index 0) (option-some-of [:option :string] "water-quality")
          (if (= topic-index 1) (option-some-of [:option :string] "best-practices")
              (option-none-of [:option :string])))
      (if (= topic-index 0) (option-some-of [:option :string] "governance")
          (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn by-topic-count [association :string candidate :string] :i64
  (if (association-covered? association)
    (if (string=? candidate "water-quality") 1
        (if (string=? candidate "best-practices") 1
            (if (string=? candidate "governance") 1 0))) 0))
(defn by-topic-id [association :string candidate :string index :i64]
  [:option :string]
  (if (association-covered? association)
    (if (= index 0)
      (if (string=? candidate "water-quality") (entry-field association 0 "id")
          (if (string=? candidate "best-practices") (entry-field association 0 "id")
              (if (string=? candidate "governance") (entry-field association 1 "id")
                  (option-none-of [:option :string]))))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn coverage-note [association :string] [:option :string]
  (if (association-covered? association)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-3600-usa-awwa Wave 0 (ADR-2607141700): 2 awwa entries seeded with official AWWA citations. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))
(defn main [] :i64 0)
